APP_ENV=development
AUTO_WORKER=true
DATABASE_URL=sqlite:///data/smartstock.db
STORAGE_PATH=data
ALLOW_SIGNUP=true
ALLOW_DEMO=true
AUTH_MODE=password
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
ENABLE_EXTERNAL_AI=false
ENABLE_WEB_SEARCH=false
ENABLE_SEMANTIC_SEARCH=false
ENABLE_MODEL_DOWNLOADS=false
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MAX_UPLOAD_MB=10
SESSION_HOURS=8
JOB_TIMEOUT_SECONDS=600
RETENTION_DAYS=90
# Docker only: generate a long random hex value; never commit the real value.
POSTGRES_PASSWORD=
INSTALL_AI=true

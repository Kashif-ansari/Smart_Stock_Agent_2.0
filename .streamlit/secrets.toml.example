# Optional OIDC. Set AUTH_MODE=oidc and use a provider verified for your deployment.
[auth]
redirect_uri = "https://YOUR-DOMAIN/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET"
client_id = "YOUR_CLIENT_ID"
client_secret = "YOUR_CLIENT_SECRET"
server_metadata_url = "https://YOUR-PROVIDER/.well-known/openid-configuration"

